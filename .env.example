APP_NAME=BR Financial AI
APP_ENVIRONMENT=local

POSTGRES_DB=br_financial_ai
POSTGRES_USER=br_financial_ai
POSTGRES_PASSWORD=br_financial_ai
POSTGRES_HOST=localhost
# Host port published by compose.yaml (container listens on 5432).
POSTGRES_PORT=5438

DATABASE_URL=postgresql+psycopg://br_financial_ai:br_financial_ai@localhost:5438/br_financial_ai

LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_TEMPERATURE=0

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional LangSmith / LangChain tracing. Leave unset so local tests
# and the application run without a tracing backend.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=br-financial-ai
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# EVAL_STABILITY_RUNS=5
# NEWS_CLASSIFICATION_CONCURRENCY=3
# EVAL_PROFILE=full
# EVAL_EXPORT=1
# EVAL_LLM_CONCURRENCY=1